        },
        "titre": {
          "type": "string"
        },
        "sousTitre": {
          "type": "string"
        },
        "objet": {
          "type": "string"
        },
        "dateCreation": {
          "type": "string"
        },
        "dateValidite": {
          "type": "string"
        },
        "statut": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "client": {
          "type": "object",
          "properties": {
            "civilite": {
              "type": "string"
            },
            "nom": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "telephone": {
              "type": "string"
            },
            "siret": {
              "type": "string"
            },
            "adresseFacturation": {
              "type": "object",
              "properties": {
                "rue": {
                  "type": "string"
                },
                "codePostal": {
                  "type": "string"
                },
                "ville": {
                  "type": "string"
                },
                "pays": {
                  "type": "string"
                }
              }
            },
            "adresseChantier": {
              "type": "object",
              "properties": {
                "rue": {
                  "type": "string"
                },
                "codePostal": {
                  "type": "string"
                },
                "ville": {
                  "type": "string"
                },
                "pays": {
                  "type": "string"
                }
              }
            }
          }
        },
        "lignes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "numero": {
                "type": "string"
              },
              "designation": {
                "type": "string"
              },
              "unite": {
                "type": "string"
              },
              "quantiteCommandee": {
                "type": "number"
              },
              "quantiteLivree": {
                "type": "number"
              },
              "quantiteRestante": {
                "type": "number"
              }
            }
          }
        }
