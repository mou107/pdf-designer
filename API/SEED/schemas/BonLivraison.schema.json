{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiobat/pdf-designer/schemas/BonLivraison/v1",
  "title": "PdfRenderPayload data — BonLivraison",
  "description": "Schema v1 des donnees de rendu pour BonLivraison. Source de verite du dictionnaire des templates .mrt et des mappers web/mobile.",
