      "type": "object",
      "properties": {
        "titreDocument": {
          "type": "string"
        },
        "sousTitreDocument": {
          "type": "string"
        },
        "masquerPrix": {
          "type": "boolean"
        },
        "lienStripe": {
          "type": "string"
        },
        "zoneSignature": {
          "type": "boolean"
        },
        "mentionsSpecifiques": {
          "type": "string"
        }
      }
    }
  }
}